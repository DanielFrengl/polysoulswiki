# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection string for the app (Neon "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/polysouls?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. Optional but
# recommended on Neon. If unset, migrations use DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/polysouls?sslmode=require"

# --- BetterAuth ------------------------------------------------------------
# Generate with: npx @better-auth/cli@latest secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Image upload (optional) ---
# Vercel Blob token used for production image uploads. Without it, uploads in
# dev are written to public/uploads/ instead.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
